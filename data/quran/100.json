{
  "id": 100,
  "name": "Al-Aadiyaat",
  "englishName": "The Chargers",
  "revelationType": "Mecca",
  "verses": [
    {
      "id": 1,
      "arabic": "وَٱلۡعَٰدِيَٰتِ ضَبۡحࣰ ا",
      "malayalam": "കിതച്ചു കൊണ്ട് ഓടുന്നവയും"
    },
    {
      "id": 2,
      "arabic": "فَٱلۡمُورِيَٰتِ قَدۡحࣰ ا",
      "malayalam": "അങ്ങനെ (കുളമ്പ് കല്ലില്‍) ഉരസി തീപ്പൊരി പറപ്പിക്കുന്നവയും"
    },
    {
      "id": 3,
      "arabic": "فَٱلۡمُغِيرَٰتِ صُبۡحࣰ ا",
      "malayalam": "എന്നിട്ട് പ്രഭാതത്തില്‍ ആക്രമണം നടത്തുന്നവയും"
    },
    {
      "id": 4,
      "arabic": "فَأَثَرۡنَ بِهِۦ نَقۡعࣰ ا",
      "malayalam": "അന്നേരത്ത് പൊടിപടലം ഇളക്കിവിട്ടവയും"
    },
    {
      "id": 5,
      "arabic": "فَوَسَطۡنَ بِهِۦ جَمۡعًا",
      "malayalam": "അതിലൂടെ (ശത്രു) സംഘത്തിന്‍റെ നടുവില്‍ പ്രവേശിച്ചവയും (കുതിരകള്‍) തന്നെ സത്യം"
    },
    {
      "id": 6,
      "arabic": "إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودࣱ‏",
      "malayalam": "തീര്‍ച്ചയായും മനുഷ്യന്‍ തന്‍റെ രക്ഷിതാവിനോട് നന്ദികെട്ടവന്‍ തന്നെ"
    },
    {
      "id": 7,
      "arabic": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدࣱ‏",
      "malayalam": "തീര്‍ച്ചയായും അവന്‍ അതിന്ന് സാക്ഷ്യം വഹിക്കുന്നവനുമാകുന്നു"
    },
    {
      "id": 8,
      "arabic": "وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ",
      "malayalam": "തീര്‍ച്ചയായും അവന്‍ ധനത്തോടുള്ള സ്നേഹം കഠിനമായവനാകുന്നു"
    },
    {
      "id": 9,
      "arabic": "۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ",
      "malayalam": "എന്നാല്‍ അവന്‍ അറിയുന്നില്ലേ? ഖബ്‌റുകളിലുള്ളത് ഇളക്കിമറിച്ച് പുറത്ത് കൊണ്ട് വരപ്പെടുകയും"
    },
    {
      "id": 10,
      "arabic": "وَحُصِّلَ مَا فِي ٱلصُّدُورِ",
      "malayalam": "ഹൃദയങ്ങളിലുള്ളത് വെളിക്ക് കൊണ്ടു വരപ്പെടുകയും ചെയ്താല്‍"
    },
    {
      "id": 11,
      "arabic": "إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذࣲ لَّخَبِيرُۢ",
      "malayalam": "തീര്‍ച്ചയായും അവരുടെ രക്ഷിതാവ് അന്നേ ദിവസം അവരെ പറ്റി സൂക്ഷ്മമായി അറിയുന്നവന്‍ തന്നെയാകുന്നു"
    }
  ]
}