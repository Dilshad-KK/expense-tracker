{
  "id": 113,
  "name": "Al-Falaq",
  "englishName": "The Dawn",
  "revelationType": "Mecca",
  "verses": [
    {
      "id": 1,
      "arabic": "قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ",
      "malayalam": "പറയുക: പുലരിയുടെ രക്ഷിതാവിനോട് ഞാന്‍ ശരണം തേടുന്നു"
    },
    {
      "id": 2,
      "arabic": "مِن شَرِّ مَا خَلَقَ",
      "malayalam": "അവന്‍ സൃഷ്ടിച്ചുട്ടുള്ളവയുടെ കെടുതിയില്‍ നിന്ന്‌"
    },
    {
      "id": 3,
      "arabic": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "malayalam": "ഇരുളടയുമ്പോഴുള്ള രാത്രിയുടെ കെടുതിയില്‍നിന്നും"
    },
    {
      "id": 4,
      "arabic": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ",
      "malayalam": "കെട്ടുകളില്‍ ഊതുന്ന സ്ത്രീകളുടെ കെടുതിയില്‍നിന്നും"
    },
    {
      "id": 5,
      "arabic": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "malayalam": "അസൂയാലു അസൂയപ്പെടുമ്പോള്‍ അവന്‍റെ കെടുതിയില്‍നിന്നും"
    }
  ]
}